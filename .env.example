# 設定の雛形。実際の .env と .env.local は次のコマンドで作る:
#   npm run setup:env -- --sheet "<スプレッドシートの URL>"
# （Next.js は .env.local を、npm run db:seed などのスクリプトは .env を読むので両方必要）
#
# このファイルにも、GitHub の Web 画面にも、本物の値を書かないこと（コミットされてしまう）。

# --- スプレッドシート ---
# URL の /d/ と /edit の間の文字列（URL を丸ごと入れてもよい）。
GOOGLE_SHEETS_ID=""

# サービスアカウントの鍵。次のどちらか一方を使う。
#  - Codespaces では、シークレット GOOGLE_SERVICE_ACCOUNT_JSON に鍵の中身を登録するのを推奨
#    （リポジトリにもディスクにも残らない）。その場合はここには何も書かない。
#  - PC で直接動かす場合は、鍵の JSON を secrets/ に置いてパスを書く（secrets/ は .gitignore 済み）。
GOOGLE_SERVICE_ACCOUNT_FILE="secrets/google-service-account.json"

# --- ログイン ---
# ログイン画面で入力するパスワード。8 文字以上。雛形の値のままだとログインを拒否する。
APP_PASSWORD="change-me"
# セッション Cookie の署名鍵。32 文字以上のランダムな文字列（npm run setup:env が作る）。
# 手で作るなら: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- 請求シートを直接読む（任意）---
# 「シート」画面で、GAS 時代の請求シートを読み取り専用で集計・突き合わせするときに既定で開く
# スプレッドシート（URL の /d/ と /edit の間の文字列か、URL そのもの）。画面でも変えられる。
# 接続は上と同じサービスアカウントを使う。請求シートを、そのアドレスに「閲覧者」として共有しておく。
# 未設定でも、画面に貼り付ければ使える。
# BILLING_SHEET_ID=""
